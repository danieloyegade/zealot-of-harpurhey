{
  "name": "zealot-of-harpurhey",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "assets:prepare": "node scripts/prepareRuntimeAssets.mjs --production",
    "assets:prepare:dev": "node scripts/prepareRuntimeAssets.mjs --development",
    "assets:validate": "node scripts/prepareRuntimeAssets.mjs --check",
    "rights:check": "node scripts/checkAssetRights.mjs",
    "predev": "npm run assets:prepare:dev",
    "dev": "vite",
    "prebuild": "npm run assets:prepare",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm test && npm run assets:validate && npm run rights:check && npm run build"
  },
  "dependencies": {
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/three": "^0.185.0",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.137.0"
  }
}
