# Copy to `.env.local` (gitignored) to override locally, or set in the deploy
# environment. Vite only exposes variables prefixed with VITE_ to the browser.

# Origin that runtime assets (models, textures, audio) are fetched from.
#
# Unset — the default — serves assets from the site itself, which is what
# `npm run dev` and any same-origin deploy want. No trailing slash needed.
#
# Set it to serve assets from a bucket or CDN instead:
#   VITE_ASSET_BASE_URL=https://assets.example.com
#
# The bucket MUST send permissive CORS headers. Three.js fetches GLBs and
# textures cross-origin, and without `Access-Control-Allow-Origin` they fail
# in a way that looks like models silently not appearing rather than an error.
# `Range` must be in the allowed headers too, or audio streaming breaks.
VITE_ASSET_BASE_URL=
